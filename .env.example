# ============================================================
# SVdrivers — пример конфигурации окружения для бэкенда (server/)
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# Файл .env находится в .gitignore и НЕ попадает в репозиторий/сборку.
# ============================================================

# --- HTTP-сервер API ---
# Порт Node.js-бэкенда (IIS reverse-proxy прокидывает /api/* на него)
PORT=4000

# Каталог для файла базы данных SQLite (svdrivers.db).
# По умолчанию: <проект>/server/data
# На Windows укажите путь без пробелов, например: C:/svdrivers-data
SVDRIVERS_DATA_DIR=

# --- Безопасность ---
# Секрет подписи JWT. Сгенерируйте длинную случайную строку:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Дополнительный «перчик» для хэшей токенов сброса/регистрации.
# Может совпадать с JWT_SECRET или быть отдельной строкой.
TOKEN_PEPPER=CHANGE_ME_TOO

# --- SMTP (отправка писем: приглашения, сброс пароля) ---
# Без этих переменных forgot-password вернёт 200, но письмо НЕ отправится!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true для порта 465 (SSL), false для 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=your-mail@gmail.com
# Для Gmail — App Password (16 символов), НЕ обычный пароль аккаунта
SMTP_PASS=your_app_password_here
# Адрес отправителя (для Gmail должен совпадать с SMTP_USER)
MAIL_FROM="SVdrivers <your-mail@gmail.com>"

# --- Ссылки в письмах ---
# Публичный адрес фронтенда (используется в ссылках подтверждения/сброса)
PUBLIC_APP_URL=http://localhost:3000

# --- Время жизни токенов (минуты) ---
REG_TOKEN_TTL_MIN=1440
RESET_TOKEN_TTL_MIN=60
